# Build output (regenerated by cargo / cmake)
SysMemInfo-rs/target/
SysMemInfo-source/build/

# Third-party SDK clone (re-clone: git clone --depth 1 https://github.com/WopsS/RED4ext.SDK.git SysMemInfo-source/deps/RED4ext.SDK)
SysMemInfo-source/deps/

# Editor / tool leftovers
*.bak
*.tmp
__pycache__/
.vs/
.vscode/
Thumbs.db
desktop.ini

# Local backups (game/mod/Vortex state snapshots, ~1 GB) - kept on disk, not in git
clean-install-backup-*/

# Third-party VR port downloads/repacks (not ours to redistribute)
CyberpunkVRPort-*.zip
CyberpunkVRPort-Auto-Installer.exe

# Vortex state database copies (contain Nexus account/OAuth data) - never commit
vortex-state-*/
